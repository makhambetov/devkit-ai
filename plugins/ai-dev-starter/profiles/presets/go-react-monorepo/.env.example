# ai-dev-starter | profile-preset | v0.1.0
# Copy to .env and fill in. Consumed by all compose services.

# Backend: 'development' allows all CORS; 'production' restricts to CORS_ALLOWED_ORIGINS.
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DB_NAME=app
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432

# Auth / secrets
JWT_SECRET=change_me

# File storage (mounted as the app_storage volume in docker-compose)
FILE_STORAGE_PATH=/app/storage

# Frontend (baked at build time)
VITE_API_URL=http://localhost:8081/api

# Deploy (roadmap)
DOMAIN_NAME=
